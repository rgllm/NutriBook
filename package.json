{
  "name": "NutriBook",
  "scripts": {
    "dev": "docker compose up",
    "stop": "docker compose down",
    "test": "pnpm backend:test && pnpm frontend:test",
    "check": "pnpm backend:ci && pnpm frontend:lint && pnpm frontend:typecheck && pnpm frontend:test && pnpm frontend:build && pnpm e2e:lint && pnpm e2e:typecheck",
    "lint": "pnpm backend:lint && pnpm frontend:lint && pnpm e2e:lint",
    "backend:test": "docker compose exec backend bin/rails test",
    "backend:lint": "docker compose exec backend bin/rubocop",
    "backend:ci": "docker compose exec backend bin/ci",
    "frontend:lint": "pnpm --dir frontend lint",
    "frontend:typecheck": "pnpm --dir frontend typecheck",
    "frontend:test": "pnpm --dir frontend test",
    "frontend:build": "pnpm --dir frontend build",
    "e2e": "pnpm --dir e2e test",
    "e2e:down": "pnpm --dir e2e down",
    "e2e:lint": "pnpm --dir e2e lint",
    "e2e:typecheck": "pnpm --dir e2e typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "private": true
}
